MINERU_TOKEN=
MINERU_BASE_URL=


# ====================
# OpenAI / LLM API (DashScope compatible)
# ====================
# API 密钥（兼容 OpenAI 格式）
OPENAI_API_KEY=
# API 基础地址（阿里云 DashScope）
OPENAI_API_BASE=
# 默认 LLM 模型
LLM_DEFAULT_MODEL=
# 默认温度参数（0-1，越低越稳定）
LLM_DEFAULT_TEMPERATURE=
# 视觉语言模型
VL_MODEL=
# 商品名识别模型
ITEM_MODEL=


# ====================
# Object Storage (MinIO)
# ====================
# MinIO 服务端点
MINIO_ENDPOINT=
# 访问密钥
MINIO_ACCESS_KEY=
# 私有密钥
MINIO_SECRET_KEY=
# 存储桶名称
MINIO_BUCKET_NAME=
# 图片上传目录
MINIO_IMG_DIR=


# ====================
# BGE Embedding Models
# ====================
# BGE-M3 模型本地路径（根据下载模型的成功提示来设置）
BGE_M3_PATH=
# BGE-M3 模型名称
BGE_M3=
# 嵌入模型运行设备，cuda:0表示使用第1块GPU，cpu表示使用CPU，cuda:N表示第N+1块GPU
BGE_DEVICE=
# 是否使用半精度（True/False）1=开启（GPU加速更高效），0=关闭（兼容低版本GPU/CPU）
BGE_FP16=


# ====================
# Vector Database (Milvus)
# ====================
# Milvus 连接地址
MILVUS_URL=
# 知识库切片集合名
CHUNKS_COLLECTION=
# 商品名称集合名
ITEM_NAME_COLLECTION=


# ====================
# Document Database (MongoDB)
# ====================
# MongoDB 连接 URL
MONGO_URL=
# 数据库名
MONGO_DB_NAME=


# ====================
# MCP Services
# ====================
# MCP Web 搜索服务地址
MCP_DASHSCOPE_BASE_URL=


# ====================
# qwen3-rerank
# ====================
